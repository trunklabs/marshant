{
  "name": "workspace",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "version": "changeset version && pnpm install --no-frozen-lockfile"
  },
