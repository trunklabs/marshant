{
  "name": "workspace",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "version": "changeset version && pnpm install --no-frozen-lockfile"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.8+sha512.f627a8e971343afe49dfd0f63d028234201dfa831d5cb588733e1e5f8db26bf16989a32161ab5c1b4db3b1fdbc373160606b5b89e002df6dd19a85adf91fc5a8",
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "2.7.5",
    "vitest": "4.0.18"
  }
}
